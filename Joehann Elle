def get_new_password():
    """Collect a non-empty password and confirmation."""
    while True:
        password = input("Create password (do not use your ID number): ")
        if len(password) < 8:
            print("Password must contain at least 8 characters.")
            continue
        confirmation = input("Confirm password: ")
        if password != confirmation:
            print("Passwords do not match. Try again.")
            continue
        return password


def register_user(data):
    """Register either a student or staff account."""
    clear_screen()
    show_header("USER REGISTRATION")

    print("1. Student")
    print("2. Staff")

    account_choice = get_number("Choose account type: ", 1, 2)

    if account_choice == 1:
        role = "student"
    elif account_choice == 2:
        role = "staff"
    else:
        role = ""

    if role == "staff":
        while True:
            staff_code = input("Staff authorization code: ").strip()
            if staff_code == STAFF_REGISTRATION_CODE:
                break
            print("Incorrect authorization code. Try again or contact the administrator.")

    while True:
        email = get_phinmaed_email()
        if not any(user["email"].lower() == email for user in data["users"]):
            break
        print("This PHINMAED email is already registered. Enter another email.")

    while True:
        user_id = get_id_number(role)
        duplicate_id = any(
            user["role"] == role and user["id_number"].lower() == user_id.lower()
            for user in data["users"]
        )
        if not duplicate_id:
            break
        print("This ID is already registered. Enter another ID.")

    full_name = get_text("Full name: ")
    password = get_new_password()

    if role == "student":
        year = get_year_level()
    else:
        year = ""

    new_user = {
        "name": full_name,
        "email": email,
        "id_number": user_id,
        "password": password,
        "role": role,
        "course": "BS Criminology",
        "year": year
    }

    data["users"].append(new_user)
    save_data(data)

    print("\nRegistration successful!")
    print("Username:", email)
    pause()


def login_user(data):
    """Return the matching user dictionary or None."""
    clear_screen()
    show_header("LOGIN")

    print("1. Student Login")
    print("2. Staff Login")
    print("3. Back")

    choice = get_number("Choose account type: ", 1, 3)

    if choice == 3:
        return None
    elif choice == 1:
        role = "student"
    else:
        role = "staff"

    email = get_phinmaed_email()
    user_id = get_id_number(role)
    while True:
        password = input("Password: ")
        if password:
            break
        print("Password cannot be empty.")

    for user in data["users"]:
        if user["role"] == role and user["email"].lower() == email.lower():
            if user["id_number"].lower() == user_id.lower():
                stored_password = user.get("password", "")
                if stored_password == password:
                    print("\nLogin successful!")
                    print("Welcome,", user["name"])
                    pause()
                    return user

    print("\nLogin failed.")
    print("Check your account type, email, ID number, and password.")
    pause()
    return None



def update_module_status(module):
    """Update availability status using an if/else expression."""
    if module["available"] > 0:
        module["status"] = "Available"
    else:
        module["status"] = "Unavailable"


def display_module(module, number=None):
    """Display a learning material using module code and subject name."""
    prefix = str(number) + ". " if number is not None else ""
    print(
        prefix + "Module Code: " + module["code"]
        + " | Subject Name: " + module["subject"]
        + " | Year: " + module["year"]
        + " | Available: " + str(module["available"])
        + "/" + str(module["total"])
        + " | Status: " + module["status"]
    )


def view_modules(data):
    """Display learning materials grouped under year-level category titles."""
    clear_screen()
    show_header("BS CRIMINOLOGY LEARNING MATERIALS")
    modules = data["modules"]
    if not modules:
        print("No learning materials found.")
        return

    categories = ["1st Year", "2nd Year", "3rd Year", "4th Year", "Other"]
    for category in categories:
        category_modules = [
            module for module in modules
            if (module.get("year", "") if module.get("year", "") in categories[:-1] else "Other") == category
        ]
        if category_modules:
            print("\n" + "=" * 72)
            print(category.upper().center(72))
            print("=" * 72)
            for index, module in enumerate(category_modules, start=1):
                display_module(module, index)


def search_modules(data):
    """Search learning materials and return matching modules."""
    clear_screen()
    show_header("SEARCH LEARNING MATERIALS")

    keyword = get_text(
        "Search module code, subject name, course, year, or status: "
    ).lower()

    results = []

    for module in data["modules"]:
        searchable_text = (
            module["code"] + " "
            + module["subject"] + " "
            + module["course"] + " "
            + module["year"] + " "
            + module["status"]
        ).lower()

        if keyword in searchable_text:
            results.append(module)

    if len(results) == 0:
        print("\nNo matching learning materials found.")
    else:
        print("\nMatching learning materials:")
        for index in range(len(results)):
            display_module(results[index], index + 1)

    return results


def choose_module(data):
    """Show modules, ask for a choice, and return the selected module."""
    modules = data["modules"]

    if len(modules) == 0:
        print("No modules available.")
        return None

    for index in range(len(modules)):
        display_module(modules[index], index + 1)

    choice = get_number(
        "Choose module: ",
        1,
        len(modules)
    )

    return modules[choice - 1]


def add_module(data):
    """Staff function for adding a module."""
    clear_screen()
    show_header("ADD LEARNING MATERIAL")

    while True:
        code = get_text("Module code (letters, numbers, hyphens only): ").upper()
        if not all(character.isalnum() or character == "-" for character in code):
            print("Invalid module code. Use letters, numbers, and hyphens only.")
            continue
        if any(module["code"].lower() == code.lower() for module in data["modules"]):
            print("That module code already exists. Enter another code.")
            continue
        break

    subject = get_text("Subject: ")
    year = get_year_level()
    total = get_quantity("Total quantity: ", 1)
    while True:
        available = get_quantity("Available quantity: ", 0)
        if available <= total:
            break
        print("Available quantity cannot be greater than total quantity. Enter it again.")
    status = "Available" if available > 0 else "Unavailable"

    new_module = {
        "code": code,
        "subject": subject,
        "course": "BS Criminology",
        "year": year,
        "available": available,
        "total": total,
        "status": status
    }

    data["modules"].append(new_module)
    save_data(data)

    print("\nLearning material added successfully.")
    pause()


def update_module(data):
    """Staff function for updating a module."""
    clear_screen()
    show_header("UPDATE LEARNING MATERIAL")

    module = choose_module(data)

    if module is None:
        pause()
        return

    print("\nSelected module:")
    display_module(module)

    print("\n1. Update module code")
    print("2. Update subject name")
    print("3. Update year level")
    print("4. Update total quantity")
    print("5. Update available quantity")
    print("6. Cancel")

    choice = get_number("Choose what to update: ", 1, 6)

    if choice == 1:
        while True:
            new_code = get_text("New module code (letters, numbers, hyphens only): ").upper()
            if not all(character.isalnum() or character == "-" for character in new_code):
                print("Invalid module code. Use letters, numbers, and hyphens only.")
                continue
            if any(other is not module and other["code"].lower() == new_code.lower()
                   for other in data["modules"]):
                print("That module code already exists. Enter another code.")
                continue
            module["code"] = new_code
            break

    elif choice == 2:
        module["subject"] = get_text("New subject name: ")

    elif choice == 3:
        module["year"] = get_year_level("New year level (1st Year/2nd Year/3rd Year/4th Year): ")

    elif choice == 4:
        while True:
            total = get_quantity("New total quantity: ", 1)
            if total >= module["available"]:
                module["total"] = total
                break
            print("Total cannot be less than available quantity. Enter it again.")

    elif choice == 5:
        while True:
            available = get_quantity("New available quantity: ", 0)
            if available <= module["total"]:
                module["available"] = available
                break
            print("Available cannot be greater than total. Enter it again.")

    else:
        return

    update_module_status(module)
    save_data(data)

    print("\nModule record updated successfully.")
    pause()



def request_claim(data, student):
    """Student function for requesting a claiming schedule."""
    clear_screen()
    show_header("REQUEST LEARNING MATERIAL CLAIM")

    available_modules = []

    for module in data["modules"]:
        if module["available"] > 0:
            if module["status"] == "Available":
                available_modules.append(module)

    if len(available_modules) == 0:
        print("No learning materials are currently available.")
        pause()
        return

    print("AVAILABLE LEARNING MATERIALS\n")

    for index in range(len(available_modules)):
        display_module(available_modules[index], index + 1)

    module_choice = get_number(
        "Choose module: ",
        1,
        len(available_modules)
    )

    selected_module = available_modules[module_choice - 1]

    print("\nAVAILABLE CLAIMING SCHEDULES\n")
    available_schedules = display_schedules(data, True)

    if len(available_schedules) == 0:
        pause()
        return

    schedule_choice = get_number(
        "Choose schedule: ",
        1,
        len(available_schedules)
    )

    selected_schedule = available_schedules[schedule_choice - 1]

    # Prevent duplicate active requests.
    for claim in data["claims"]:
        if claim["student_email"].lower() == student["email"].lower():
            if claim["module_code"] == selected_module["code"]:
                if claim["status"] == "Pending" or claim["status"] == "Confirmed":
                    print("\nYou already have an active claim for this module.")
                    pause()
                    return

    new_claim = {
        "id": data["next_claim_id"],
        "student_name": student["name"],
        "student_email": student["email"],
        "student_id": student["id_number"],
        "module_code": selected_module["code"],
        "module_subject": selected_module["subject"],
        "schedule_id": selected_schedule["id"],
        "date": selected_schedule["date"],
        "time": selected_schedule["time"],
        "status": "Pending"
    }

    # Reserve one copy immediately so concurrent requests in this program
    # cannot all claim the same final copy while awaiting staff approval.
    if selected_module["available"] <= 0:
        print("Sorry, no copy remains for this module.")
        pause()
        return

    selected_module["available"] -= 1
    update_module_status(selected_module)
    data["claims"].append(new_claim)
    data["next_claim_id"] += 1

    # One schedule slot is reserved for the request.
    selected_schedule["slots"] -= 1

    if selected_schedule["slots"] == 0:
        selected_schedule["status"] = "Closed"

    save_data(data)

    print("\nClaim request submitted successfully.")
    print("Subject Name:", selected_module["subject"])
    print("Module Code:", selected_module["code"])
    print("Date:", selected_schedule["date"])
    print("Time:", selected_schedule["time"])
    print("Status: Pending")
    pause()


def view_my_claims(data, student):
    """Display claims belonging to the logged-in student."""

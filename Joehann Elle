def student_menu(data, student):
    """Console menu for students."""
    while True:
        clear_screen()
        show_header("BS CRIMINOLOGY STUDENT MENU")

        print("Student:", student["name"])
        print("Email:", student["email"])
        print("Year:", student["year"])
        print()
        print("1. View Learning Materials")
        print("2. Search Learning Materials")
        print("3. View Claiming Schedules")
        print("4. Request Claiming Schedule")
        print("5. View My Claims")
        print("6. Logout")

        choice = get_number("Choose an option: ", 1, 6)

        if choice == 1:
            view_modules(data)
            pause()

        elif choice == 2:
            search_modules(data)
            pause()

        elif choice == 3:
            clear_screen()
            show_header("CLAIMING SCHEDULES")
            print("\nSCHEDULE CATEGORY")
            display_schedules(data, True)
            pause()

        elif choice == 4:
            request_claim(data, student)

        elif choice == 5:
            view_my_claims(data, student)

        else:
            print("\nStudent logged out.")
            pause()
            break



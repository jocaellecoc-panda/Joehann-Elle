# ============================================================

def save_data(data):
    """Data is kept in lists in memory; no file/pickle storage is used."""
    return


def load_data():
    """Create a fresh set of list-based records for this run."""
    return {
        key: [item.copy() if isinstance(item, dict) else item for item in value] if isinstance(value, list) else value
        for key, value in DEFAULT_DATA.items()
    }


# ============================================================
# GENERAL FUNCTIONS
# ============================================================

def clear_screen():
    """Separate console screens without using operating-system commands."""
    print("\n" * 3)


def pause():
    input("\nPress ENTER to continue...")


def show_header(title):
    print("\n" + "=" * 72)
    print(title.center(72))
    print("=" * 72)


def get_text(prompt):
    """Keep asking until the user enters non-empty text."""
    while True:
        value = input(prompt).strip()
        if value:
            return value
        print("Input cannot be empty. Please try again.")


def get_number(prompt, minimum=1, maximum=None):
    """Validate integer input and keep looping until it is in range."""
    while True:
        value = input(prompt).strip()
        try:
            number = int(value)
        except ValueError:
            print("Invalid input. Enter a whole number.")
            continue
        if number < minimum:
            print("Number must be at least", minimum, ".")
            continue
        if maximum is not None and number > maximum:
            print("Number must not be greater than", maximum, ".")
            continue
        return number


def get_quantity(prompt, minimum=0):
    """Validate quantity input and keep looping until it meets the minimum."""
    while True:
        value = input(prompt).strip()
        try:
            quantity = int(value)
        except ValueError:
            print("Invalid quantity. Enter a whole number.")
            continue
        if quantity < minimum:
            print("Quantity must be at least", minimum, ".")
            continue
        return quantity


def get_phinmaed_email():
    """Require a non-empty email ending in @phinmaed.com."""
    while True:
        email = input("PHINMAED email: ").strip().lower()
        if "@" in email and email.split("@", 1)[0] and email.endswith("@phinmaed.com"):
            return email
        print("Invalid email. Use an address ending in @phinmaed.com.")


def get_id_number(role):
    """Validate a student/faculty ID and keep asking if it is invalid."""
    label = "Student ID" if role == "student" else "Faculty ID"
    while True:
        user_id = input(label + ": ").strip()
        if user_id and all(character.isalnum() or character in "-_" for character in user_id):
            return user_id
        print("Invalid ID. Use letters, numbers, hyphens, or underscores.")


def get_year_level(prompt="Year level (1st Year/2nd Year/3rd Year/4th Year): "):
    """Accept only the four supported year levels."""
    valid_years = {
        "1st year": "1st Year",
        "2nd year": "2nd Year",
        "3rd year": "3rd Year",
        "4th year": "4th Year",
    }
    while True:
        year = input(prompt).strip().lower()
        if year in valid_years:
            return valid_years[year]
        print("Invalid year level. Enter 1st Year, 2nd Year, 3rd Year, or 4th Year.")


def get_schedule_date():
    """Accept only a real date in the 2026-2027 school year."""
    while True:
        date_text = get_text("Schedule date in school year 2026-2027 (YYYY-MM-DD): ")
        try:
            parsed_date = datetime.strptime(date_text, "%Y-%m-%d")
            if parsed_date.strftime("%Y-%m-%d") == date_text and parsed_date.year in (2026, 2027):
                return date_text
        except ValueError:
            pass
        print("Invalid date. Enter a real date in 2026 or 2027, such as 2026-10-25.")


def get_time_range():
    """Validate a time range inside 8:30 AM to 4:30 PM."""
    while True:
        value = get_text("Schedule time (8:30 AM - 4:30 PM, e.g. 9:00 AM - 10:00 AM): ").upper()
        parts = value.split("-")
        if len(parts) != 2:
            print("Invalid time range. Use START AM/PM - END AM/PM.")
            continue
        try:
            start = datetime.strptime(parts[0].strip(), "%I:%M %p")
            end = datetime.strptime(parts[1].strip(), "%I:%M %p")
            earliest = datetime.strptime(CLAIMING_START_TIME, "%I:%M %p")
            latest = datetime.strptime(CLAIMING_END_TIME, "%I:%M %p")
            if end <= start:
                print("End time must be later than start time.")
                continue
            if start < earliest or end > latest:
                print("Claiming time must be between 8:30 AM and 4:30 PM.")
                continue
            return start.strftime("%I:%M %p") + " - " + end.strftime("%I:%M %p")
        except ValueError:
            print("Invalid time. Example: 9:00 AM - 10:00 AM.")



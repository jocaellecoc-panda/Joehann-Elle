# ============================================================
# MAIN CONSOLE SYSTEM FLOW
# ============================================================

def main():
    """Main system flow."""
    data = load_data()

    while True:
        clear_screen()
        show_header(
            "BS CRIMINOLOGY LEARNING MATERIALS MONITORING "
            "& CLAIMING SCHEDULE SYSTEM"
        )

        print("PHINMA Cagayan de Oro College")
        print()
        print("1. Register")
        print("2. Login")
        print("3. Exit")

        choice = get_number("Choose an option: ", 1, 3)

        if choice == 1:
            register_user(data)

        elif choice == 2:
            logged_user = login_user(data)

            if logged_user is not None:
                if logged_user["role"] == "staff":
                    staff_menu(data, logged_user)
                else:
                    student_menu(data, logged_user)

        else:
            save_data(data)
            clear_screen()
            show_header("SYSTEM CLOSED")
            print("Thank you for using the system.")
            break


# ============================================================
# START THE PROGRAM DIRECTLY
# No if __name__ == "__main__" launcher is used.
# ============================================================

main()

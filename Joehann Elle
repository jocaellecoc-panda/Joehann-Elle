def display_schedules(data, only_available=True):
    """Display schedules and return the displayed schedule list."""
    schedules = data["schedules"]

    if only_available:
        schedules = [
            schedule
            for schedule in schedules
            if schedule["status"] == "Available"
            and schedule["slots"] > 0
        ]

    if len(schedules) == 0:
        print("No claiming schedules available.")
        return []

    # Column titles make each schedule category clear.
    print(f"{'ID':<5} {'DATE':<14} {'TIME':<24} {'AVAILABLE SLOTS':<18} {'STATUS'}")
    print("-" * 76)
    for schedule in schedules:
        print(
            f"{schedule['id']:<5} {schedule['date']:<14} "
            f"{schedule['time']:<24} {schedule['slots']:<18} {schedule['status']}"
        )

    return schedules


def create_schedule(data):
    """Staff function for creating a claiming schedule."""
    clear_screen()
    show_header("CREATE CLAIMING SCHEDULE - SCHOOL YEAR " + SCHOOL_YEAR)

    date_text = get_schedule_date()
    time_text = get_time_range()
    slots = get_quantity("Number of available slots: ", 1)

    schedule = {
        "id": data["next_schedule_id"],
        "date": date_text,
        "time": time_text,
        "slots": slots,
        "status": "Available",
        "school_year": SCHOOL_YEAR
    }

    data["schedules"].append(schedule)
    data["next_schedule_id"] += 1
    save_data(data)

    print("\nClaiming schedule created successfully.")
    print("Schedule Date:", schedule["date"])
    print("Schedule Time:", schedule["time"])
    print("Schedule Status:", schedule["status"])
    pause()


def update_schedule(data):
    """Staff function for changing a schedule status."""
    clear_screen()
    show_header("UPDATE CLAIMING SCHEDULE - SCHOOL YEAR " + SCHOOL_YEAR)

    if len(data["schedules"]) == 0:
        print("No schedules found.")
        pause()
        return

    display_schedules(data, False)

    while True:
        schedule_id = get_number("Enter an existing schedule ID: ", 1)
        selected = next((schedule for schedule in data["schedules"]
                         if schedule["id"] == schedule_id), None)
        if selected is not None:
            break
        print("Schedule ID not found. Choose an ID shown in the table.")

    print("\n1. Available")
    print("2. Closed")
    print("3. Cancelled")

    choice = get_number("Choose status: ", 1, 3)

    if choice == 1:
        selected["status"] = "Available"
    elif choice == 2:
        selected["status"] = "Closed"
    else:
        selected["status"] = "Cancelled"

    save_data(data)

    print("Schedule updated successfully.")
    pause()



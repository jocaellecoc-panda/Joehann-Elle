def update_claim_status(data):
    """Staff function for confirming, completing, or cancelling claims."""
    clear_screen()
    show_header("UPDATE CLAIM STATUS")

    if len(data["claims"]) == 0:
        print("No claiming records found.")
        pause()
        return

    for claim in data["claims"]:
        print(
            str(claim["id"]) + ". "
            + claim["student_name"] + " | "
            + claim.get("module_subject", claim.get("module_code", "Unknown subject")) + " | "
            + claim["status"]
        )

    while True:
        claim_id = get_number("Enter an existing claim ID: ", 1)
        selected_claim = next((claim for claim in data["claims"]
                               if claim["id"] == claim_id), None)
        if selected_claim is not None:
            break
        print("Claim ID not found. Choose an ID shown above.")

    print("\n1. Leave as Pending")
    print("2. Approve request")
    print("3. Mark as Completed (student received the module)")
    print("4. Reject/Cancel request")

    choice = get_number("Choose an action: ", 1, 4)

    if choice == 1:
        new_status = "Pending"
    elif choice == 2:
        new_status = "Confirmed"
    elif choice == 3:
        new_status = "Completed"
    else:
        new_status = "Cancelled"

    old_status = selected_claim["status"]

    if old_status == "Completed" and new_status != "Completed":
        print("A completed claim cannot be changed because the module was recorded as distributed.")
        pause()
        return

    if old_status == "Cancelled" and new_status != "Cancelled":
        print("A cancelled claim cannot be reopened. Ask the student to submit a new request.")
        pause()
        return

    selected_module = None
    for module in data["modules"]:
        if module["code"] == selected_claim["module_code"]:
            selected_module = module
            break

    # Copies are reserved when a request is submitted, not at completion.
    # Completing a request therefore does not subtract a second copy.
    if new_status == "Cancelled" and old_status in ("Pending", "Confirmed"):
        if selected_module is not None and selected_module["available"] < selected_module["total"]:
            selected_module["available"] += 1
            update_module_status(selected_module)

        # Release the schedule slot reserved by this request.
        for schedule in data["schedules"]:
            if schedule["id"] == selected_claim["schedule_id"]:
                schedule["slots"] += 1
                if schedule["status"] in ("Closed", "Cancelled"):
                    schedule["status"] = "Available"
                break

    selected_claim["status"] = new_status
    save_data(data)

    print("\nClaim status updated to:", new_status)
    pause()



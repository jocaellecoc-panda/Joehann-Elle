def view_registered_users(data):
    """Allow staff to review registered student and staff accounts."""
    clear_screen()
    show_header("REGISTERED STUDENT AND STAFF ACCOUNTS")
    if not data["users"]:
        print("No registered accounts found.")
        pause()
        return
    for index, user in enumerate(data["users"], start=1):
        print(str(index) + ". " + user["name"])
        print("   Role:", user["role"].title())
        print("   Email:", user["email"])
        # Do not display student/faculty ID numbers in the account listing.
        if user["role"] == "student":
            print("   Course:", user.get("course", "BS Criminology"))
            print("   Year:", user.get("year", "Not provided"))
        print("-" * 72)
    pause()


